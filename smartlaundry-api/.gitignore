# =====================================
# GRADLE
# =====================================
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Local environment files (never commit)
.env
.env.*
*.local
*.secret
*.env.properties
src/main/resources/.env*
src/main/resources/*.local.properties

# ==== Allow Flyway migration files ====
!src/main/resources/db/**
!src/main/resources/db/migration/**


# =====================================
# SPRING RESOURCES (KEEP EVERYTHING ELSE)
# DO NOT IGNORE: application.properties, db/migration, static/, templates/
# =====================================
# Only ignore personal/local variants
src/main/resources/application-local.properties
src/main/resources/application-test.properties

